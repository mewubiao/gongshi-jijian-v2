# 演示专用，本机 PostgreSQL；不要把 .env 提交到版本库。
DATABASE_URL=postgres://workshop:local-demo-only@127.0.0.1:55432/workshop?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
# 非 -demo 模式必须自行设置至少12字符密码；主管密码留空时禁止主管登录。
# ADMIN_PASSWORD=replace-with-your-own-password
# SUPERVISOR_PASSWORD=replace-with-your-own-password
